<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>WhatsApp multi-device for .NET through whatsmeow: sessions, pairing, messages, media, groups, contacts, presence and history, with at least once event delivery. Starts and supervises the whatsmeow-net sidecar, which comes with it.</Description>
		<!-- C# root per ARCHITECTURE Naming: the entry point and shared public types sit at the root (ADR 0018). -->
		<RootNamespace>Whatsmeow</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.HealthCheck" />
		<PackageReference Include="Grpc.Net.Client" />
		<PackageReference Include="Grpc.StatusProto" />
		<PackageReference Include="Vogen" />
		<!-- Exactly this package's version: the client is compiled against the generated code and its internals, and the
		Raw hatch's types come from Whatsmeow.Protocol.WhatsApp through it (ADR 0055). -->
		<ProjectReference Include="../Whatsmeow.Protocol/Whatsmeow.Protocol.csproj" PackExactVersion="true" />
	</ItemGroup>

	<!--
		The sidecar binaries, at exactly this package's version (§13 invariant 12, ADR 0023, ADR 0069). A plain reference: one with
		ReferenceOutputAssembly="false" never reaches restore, so pack would drop the dependency.
	-->
	<ItemGroup>
		<ProjectReference Include="../Whatsmeow.Sidecar.Native/Whatsmeow.Sidecar.Native.csproj" PackExactVersion="true" />
	</ItemGroup>

	<!-- Stable package: its public API is tracked in PublicAPI.*.txt (RS0016/RS0017 are errors, dotnet/.globalconfig); the analyzer package adds both files as AdditionalFiles itself. -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- The supervisor's restart and backoff state machine (docs/guidelines/tests.md). -->
		<InternalsVisibleTo Include="Whatsmeow.Client.Tests" />
		<!-- Only for two seams the public API cannot reach: the protocol range (the real sidecar cannot be made to report
		another protocol), and fake WhatsApp mode with its control channel (ADR 0019). -->
		<InternalsVisibleTo Include="Whatsmeow.IntegrationTests" />
		<!-- The live tests' control channel, served by a livetest build only (ADR 0060). -->
		<InternalsVisibleTo Include="Whatsmeow.LiveTests" />
		<!-- The events host of the kill-the-.NET-side test starts a fake-mode sidecar, the second seam above. -->
		<InternalsVisibleTo Include="SidecarHost" />
		<!-- The hosting package creates the sidecar unstarted and shares the options' setup step and rules (ADR 0034); it
		depends on this package at exactly its version, so the internals always match. -->
		<InternalsVisibleTo Include="Whatsmeow.Extensions.Hosting" />
		<!-- FakeWhatsAppClient runs the client's own event pipeline, so its ordering and handler errors are the client's
		(ADR 0036); it depends on this package at exactly its version. -->
		<InternalsVisibleTo Include="Whatsmeow.Testing" />
	</ItemGroup>

	<ItemGroup Label="Usings">
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="Microsoft.Extensions.Logging" />
	</ItemGroup>
</Project>
