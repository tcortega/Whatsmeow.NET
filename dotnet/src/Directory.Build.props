<Project>
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

	<!-- Everything under src/ ships: AOT and trim clean, checked by tests/AotSmoke (docs/guidelines/csharp.md Reflection). -->
	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>

		<!-- Library delta: public members of shipped code need XML docs (CS1591 is an error in /.editorconfig for dotnet/src). -->
		<NoWarn>$(NoWarn.Replace(',1591', ''))</NoWarn>
		<WhatsmeowBaselineNoWarn>$(NoWarn)</WhatsmeowBaselineNoWarn>
	</PropertyGroup>
</Project>
