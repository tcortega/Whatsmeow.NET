<Project>
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

	<!-- Everything under src/ ships: AOT and trim clean, checked by tests/AotSmoke (docs/guidelines/csharp.md Reflection). -->
	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>

		<!-- Library delta: public members of shipped code need XML docs (CS1591 is an error in /.editorconfig for dotnet/src). -->
		<NoWarn>$(NoWarn.Replace(',1591', ''))</NoWarn>

		<!-- The repository and the .NET packages are MPL-2.0 (ADR 0016); the native packages override it below. -->
		<PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
	</PropertyGroup>

	<!--
		Every package's nuget.org page (ADR 0054): Authors and Copyright as NOTICE says, the repository, the tags, and the
		README.md next to each project (the native packages' is below). Each csproj sets its own Description.
		build/ci.sh install checks each of these in the packages.
	-->
	<PropertyGroup>
		<Authors>Tarcisio Ortega</Authors>
		<Copyright>Copyright (c) 2026 Tarcisio Ortega</Copyright>
		<PackageProjectUrl>https://github.com/tcortega/Whatsmeow.NET</PackageProjectUrl>
		<RepositoryUrl>https://github.com/tcortega/Whatsmeow.NET</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>whatsapp;whatsmeow;whatsapp-multi-device;messaging;bot</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup Condition="!$(MSBuildProjectName.StartsWith('Whatsmeow.Sidecar.Native.'))">
		<None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<!--
		The native packages hold whatsmeow-net, which links GPL-3.0-or-later libsignal and is conveyed under GPL-3.0-only
		as a whole (ADR 0016). Each carries the GPL-3.0 text, NOTICE, every licence file sidecar/licenses.allow lists, and a
		README saying where the Corresponding Source is (ADR 0029). build/ci.sh install checks each file and expression.
	-->
	<PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Whatsmeow.Sidecar.Native.'))">
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup Condition="$(MSBuildProjectName.StartsWith('Whatsmeow.Sidecar.Native.'))">
		<None Include="$(MSBuildThisFileDirectory)Whatsmeow.Sidecar.Native.md" Pack="true" PackagePath="README.md" />
		<None Include="$(MSBuildThisFileDirectory)../../sidecar/COPYING" Pack="true" PackagePath="" />
		<None Include="$(MSBuildThisFileDirectory)../../NOTICE" Pack="true" PackagePath="" />
		<None Include="$(MSBuildThisFileDirectory)../../sidecar/THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>
