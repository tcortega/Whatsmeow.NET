<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Pack-only: whatsmeow-net for every release target, which build/ci.sh package builds into dotnet/artifacts/sidecar/
		(ADR 0023, ADR 0069). Pack fails when a binary is missing. Whatsmeow.Client depends on this package at exactly
		its own version. The assembly it builds is empty, never packed and never referenced at run time.
	-->
	<PropertyGroup>
		<Description>The whatsmeow-net sidecar binary for linux-x64, linux-arm64 (glibc and musl), osx-x64, osx-arm64, win-x64 and win-arm64. Whatsmeow.Client brings it; GPL-3.0-only object code, its source on each GitHub release.</Description>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(ArtifactsPath)/sidecar/linux-x64/whatsmeow-net" Pack="true" PackagePath="runtimes/linux-x64/native/" />
		<None Include="$(ArtifactsPath)/sidecar/linux-arm64/whatsmeow-net" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
		<None Include="$(ArtifactsPath)/sidecar/osx-x64/whatsmeow-net" Pack="true" PackagePath="runtimes/osx-x64/native/" />
		<None Include="$(ArtifactsPath)/sidecar/osx-arm64/whatsmeow-net" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
		<None Include="$(ArtifactsPath)/sidecar/win-x64/whatsmeow-net.exe" Pack="true" PackagePath="runtimes/win-x64/native/" />
		<None Include="$(ArtifactsPath)/sidecar/win-arm64/whatsmeow-net.exe" Pack="true" PackagePath="runtimes/win-arm64/native/" />
		<None Include="Whatsmeow.Sidecar.Native.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
	</ItemGroup>
</Project>
