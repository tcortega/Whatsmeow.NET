is_global = true

# Generated code (protoc, and later Vogen, [LoggerMessage], System.Text.Json) is never hand-edited, so a banned
# symbol there cannot be fixed at the call site. Protobuf's generated ToString() calls JsonFormatter, for example.
# Trim and AOT analysis still covers it: tests/AotSmoke roots every shipped assembly.
dotnet_banned_api_analyzer.exclude_generated_code = true

# Public API of stable packages (PublicApiAnalyzers, Whatsmeow.Client). Global, because RS0017 is reported on the
# PublicAPI.*.txt files, which no [*.cs] section of /.editorconfig covers.
dotnet_diagnostic.RS0016.severity = error
dotnet_diagnostic.RS0017.severity = error
