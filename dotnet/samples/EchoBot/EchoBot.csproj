<Project Sdk="Microsoft.NET.Sdk">
	<!-- The hosted sample: two sessions that echo texts, on the public API only (no project gives it internals, ADR 0049). -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
		<PackageReference Include="QRCoder" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/Whatsmeow.Extensions.Hosting/Whatsmeow.Extensions.Hosting.csproj" />
	</ItemGroup>
</Project>
