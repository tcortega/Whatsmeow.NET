<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>
		<!-- Pairs with protoc in /mise.toml: protoc 36.2 generates the code this runtime reads. -->
		<PackageVersion Include="Google.Protobuf" Version="3.36.2" />
		<!-- Pairs with Grpc.Tools in /mise.toml: its grpc_csharp_plugin generates the client stubs this runtime reads. -->
		<PackageVersion Include="Grpc.Core.Api" Version="2.85.0" />
		<!-- The client's grpc.health.v1 Watch, how External mode notices the sidecar is gone (ADR 0046); Apache-2.0. -->
		<PackageVersion Include="Grpc.HealthCheck" Version="2.85.0" />
		<PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
		<PackageVersion Include="Grpc.StatusProto" Version="2.85.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="11.0.0" />
		<!-- The tests' generic host; Whatsmeow.Extensions.Hosting itself needs only the abstractions. -->
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
		<!-- BindConfiguration, and the configuration binding generator it brings (Microsoft.Extensions.Configuration.Binder). -->
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
		<!-- The sample's exporter only, never a library package's dependency (#42); Apache-2.0. -->
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
		<!-- The live tests and the sample, to render the QR code a person scans; MIT. Never in a shipped project (build/ci.sh). -->
		<PackageVersion Include="QRCoder" Version="1.8.1" />
		<!-- A runtime dependency of consumers too (Vogen.SharedTypes): never PrivateAssets (ADR 0010). -->
		<PackageVersion Include="Vogen" Version="8.0.7" />
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>

	<ItemGroup>
		<GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.318" />
		<GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
		<!-- The one version source: a v<semver> tag, or a pre-release from the height above the last one (ADR 0023). -->
		<GlobalPackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
	</ItemGroup>
</Project>
