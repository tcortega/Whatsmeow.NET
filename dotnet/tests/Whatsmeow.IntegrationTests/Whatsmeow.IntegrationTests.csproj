<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
		<PackageReference Include="xunit.v3" />
	</ItemGroup>

	<ItemGroup>
		<!-- The live tests reuse the pairing checks and the sidecar build (docs/guidelines/tests.md Live WhatsApp). -->
		<InternalsVisibleTo Include="Whatsmeow.LiveTests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/Whatsmeow.Client/Whatsmeow.Client.csproj" />
		<ProjectReference Include="../../src/Whatsmeow.Extensions.Hosting/Whatsmeow.Extensions.Hosting.csproj" />
		<!-- The hosted sample, whose own setup the sample's FullCycle runs against a fake-mode sidecar (ADR 0049). -->
		<ProjectReference Include="../../samples/EchoBot/EchoBot.csproj" />
		<ProjectReference Include="../../samples/EchoConsole/EchoConsole.csproj" />
		<!-- Built first, for the kill-parent test and the kill-the-.NET-side events test. -->
		<ProjectReference Include="../SidecarHost/SidecarHost.csproj" />
	</ItemGroup>

	<ItemGroup Label="Usings">
		<Using Include="Xunit" />
		<Using Include="Microsoft.Extensions.Logging" />
	</ItemGroup>
</Project>
