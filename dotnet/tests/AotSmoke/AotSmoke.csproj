<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Publishes every shipped assembly with Native AOT; any trim or AOT warning fails the publish. In the repository it
		references the projects; build/ci.sh aot copies it out of the repository with AotSmokeFromFeed set, so it
		references the packages of a local feed instead, at the versions of the Directory.Packages.props it writes there
		(ADR 0056).
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<PublishAot>true</PublishAot>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!--
			Every CI RID is listed so packages.lock.json is the same on every OS. The RID comes from the SDK's own host,
			set here instead of with -r: a command-line -r flows to the referenced libraries, whose lock files have no RID,
			and locked restore then fails with NU1004 [observed: scaffold, #2].
		-->
		<RuntimeIdentifiers>linux-x64;osx-arm64;win-x64</RuntimeIdentifiers>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
	</PropertyGroup>

	<!-- The hosting path: options bound from configuration and a keyed session (ADR 0034, ADR 0056). -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" />
	</ItemGroup>

	<ItemGroup Condition="'$(AotSmokeFromFeed)' != 'true'">
		<ProjectReference Include="../../src/Whatsmeow.Client/Whatsmeow.Client.csproj" />
		<ProjectReference Include="../../src/Whatsmeow.Extensions.Hosting/Whatsmeow.Extensions.Hosting.csproj" />
		<ProjectReference Include="../../src/Whatsmeow.Protocol/Whatsmeow.Protocol.csproj" />
		<ProjectReference Include="../../src/Whatsmeow.Protocol.WhatsApp/Whatsmeow.Protocol.WhatsApp.csproj" />
		<ProjectReference Include="../../src/Whatsmeow.Testing/Whatsmeow.Testing.csproj" />
	</ItemGroup>

	<!-- Whatsmeow.Client brings Whatsmeow.Protocol, Whatsmeow.Protocol.WhatsApp and the native package of each OS. -->
	<ItemGroup Condition="'$(AotSmokeFromFeed)' == 'true'">
		<PackageReference Include="Whatsmeow.Client" />
		<PackageReference Include="Whatsmeow.Extensions.Hosting" />
		<PackageReference Include="Whatsmeow.Testing" />
	</ItemGroup>

	<!-- Rooted, so the compiler analyzes all of each shipped assembly, not only what Program.cs reaches. -->
	<ItemGroup>
		<TrimmerRootAssembly Include="Whatsmeow.Client" />
		<TrimmerRootAssembly Include="Whatsmeow.Extensions.Hosting" />
		<TrimmerRootAssembly Include="Whatsmeow.Protocol" />
		<TrimmerRootAssembly Include="Whatsmeow.Protocol.WhatsApp" />
		<TrimmerRootAssembly Include="Whatsmeow.Testing" />
		<TrimmerRootAssembly Include="Grpc.HealthCheck" />
	</ItemGroup>
</Project>
