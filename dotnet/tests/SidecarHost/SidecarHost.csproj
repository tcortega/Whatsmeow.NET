<Project Sdk="Microsoft.NET.Sdk">
	<!-- The parent process of the kill-parent integration test and the process the events kill test kills; not a test project itself. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<!-- [LibraryImport] generates unsafe code (SYSLIB1062): dup and the handle flags of HeldTetherHost. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/Whatsmeow.Client/Whatsmeow.Client.csproj" />
	</ItemGroup>
</Project>
